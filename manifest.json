{
  "manifest_version": 3,
  "name": "Viewport HUD",
  "version": "0.1.0",
  "description": "Draw a viewport selection and inspect its React component metadata.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle Viewport HUD"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["reactFiberInspector.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-viewport-hud": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "Toggle Viewport HUD"
    }
  }
}
